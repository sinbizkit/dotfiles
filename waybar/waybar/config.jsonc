{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "min-height": 40, // Waybar height (to be removed for auto height)
    "spacing": 4, // Gaps between modules (4px)

    // Include local configurations.
    "include": "~/.config/waybar/.local.config.d/*",

    // Default modules configuration.
    "modules-left": ["disk", "cpu", "memory", "temperature", "backlight", "sway/scratchpad", "sway/mode" ],
    "modules-center": ["sway/workspaces"],
    "modules-right": [ "idle_inhibitor", "tray", "battery", "clock", "sway/language", "group/group-power" ],

    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },
    "disk": {
        "format": " {percentage_used}%",
        "path": "/"
    },
    "keyboard-state": {
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "sway/mode": {
        "format": " {}"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 24,
        "spacing": 10
    },
    "clock": {
        // "timezone": "America/New_York",
        "format": "󰥔 {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "󰃭 {:%d-%m-%y}"
    },
    "memory": {
        "format": " {}%"
    },
    "temperature": {
        "thermal-zone": 0,
        "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
        "warning-threshold": 75,
        "critical-threshold": 85,
        "format": "{icon} {temperatureC}°",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "on-click": "nm-connection-editor"
    },

    "group/group-power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 250,
            "transition-left-to-right": false,
        },
        "modules": [
            "custom/admin",	
            "custom/lock",
            "custom/logout",
            "custom/reboot",
            "custom/power",
        ]
    },
    "custom/admin": {
        "format": "󰍹",
        "tooltip": false,
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "systemctl poweroff"
    },
    "custom/reboot": {
        "format": "",
        "tooltip": false,
        "on-click": "systemctl reboot"
    },
    "custom/logout": {
        "format": "",
        "tooltip": false,
        "on-click": "swaymsg exit"
    },
    "custom/lock": {
        "format": "",
        "tooltip": false,
        "on-click": "swaylock -f -i /home/ivan/Pictures/wallpaper/lock-screen.png"
    }
}
